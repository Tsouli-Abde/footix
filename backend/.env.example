# Port d'écoute de l'API
PORT=3001

# Base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./data/footix.db"

# Origines autorisées pour CORS, séparées par des virgules.
# En dev le frontend Vite tourne sur 5173.
CORS_ORIGINS="http://localhost:5173"

# Notifications push (Web Push / VAPID).
# Générer une paire avec : npx web-push generate-vapid-keys
# Sans ces clés, les notifications sont simplement désactivées (le reste marche).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact exigé par la spec Web Push (un mailto suffit).
VAPID_SUBJECT="mailto:footix@example.com"
