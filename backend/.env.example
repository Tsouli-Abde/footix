# Les ports de dev sont tous en 29xxx, exprès : ils s'ouvrent sur une machine où
# d'autres projets tournent, et cette plage n'est utilisée par presque rien (elle
# est aussi hors de la plage éphémère de Windows, qui commence à 49152).

# Port d'écoute de l'API
PORT=29301

# Base PostgreSQL. En dev, la lancer depuis la racine du repo :
#   docker compose up -d db
# Le conteneur publie 29433 sur la machine (voir docker-compose.yml).
DATABASE_URL="postgresql://footix:footix@localhost:29433/footix?schema=public"

# Origines autorisées pour CORS, séparées par des virgules.
# En dev le frontend Vite tourne sur 29173.
CORS_ORIGINS="http://localhost:29173"

# Notifications push (Web Push / VAPID).
# Générer une paire avec : npx web-push generate-vapid-keys
# Sans ces clés, les notifications sont simplement désactivées (le reste marche).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact exigé par la spec Web Push (un mailto suffit).
VAPID_SUBJECT="mailto:footix@example.com"
