// Schéma Footix.
//
// SQLite ne supporte pas les enums Prisma, donc les champs "énumérés" sont des
// String dont les valeurs autorisées sont validées côté API (voir src/domain.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Un sondage "foot vendredi ?" pour une date donnée.
///
/// Il n'y a plus d'options à voter : chacun dit juste s'il est dispo, et le lieu
/// se déduit du nombre de présents (cf. recommendVenue dans src/domain.ts).
model Event {
  id String @id @default(cuid())

  /// Facultatif : sans titre, c'est la date qui sert d'intitulé. Évite de
  /// répéter "Foot vendredi ?" sur toutes les lignes de l'historique.
  title       String?
  description String?

  /// "ponctuel" | "recurrent"
  type String @default("ponctuel")

  /// Jour du match. L'heure est fixée à midi et n'est jamais affichée :
  /// on joue toujours sur la pause déj, ça n'a pas besoin d'être précisé.
  matchDate DateTime

  /// Jour du match au format YYYY-MM-DD.
  /// Unique : c'est la garantie anti-doublon (un seul sondage par jour).
  occurrenceKey String @unique

  /// Fin des réponses.
  voteDeadline DateTime

  /// "ouvert" | "cloture"
  status String @default("ouvert")

  /// Lieu retenu à la clôture ("five" | "sceaux" | "externe").
  /// L'app recommande, l'organisateur tranche.
  chosenVenue String?

  /// Score final, saisi librement après le match ("5-3", "on n'a pas compté").
  score String?

  /// Deux mots sur le match, à côté du score.
  resultNote String?

  /// Token du lien partagé sur Teams (voir et répondre).
  publicToken String @unique

  /// Token du lien de gestion (modifier, clôturer). À ne pas partager.
  organizerToken String @unique

  recurrenceTemplateId String?
  recurrenceTemplate   RecurrenceTemplate? @relation(fields: [recurrenceTemplateId], references: [id], onDelete: SetNull)

  participants Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchDate])
}

/// Quelqu'un qui a répondu. Pas de compte, juste un prénom saisi librement.
model Participant {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name String

  /// Nom normalisé (minuscules, sans accent ni espaces superflus).
  /// Sert à retrouver quelqu'un qui revient changer sa réponse.
  nameKey String

  /// "oui" | "si_besoin" | "non"
  availability String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, nameKey])
}

/// Un navigateur abonné aux notifications push (Web Push API).
///
/// Pas de compte : on garde juste de quoi pousser un message vers ce navigateur.
/// L'abonnement est global à l'équipe, chacun s'abonne une fois depuis son appareil.
model PushSubscription {
  id String @id @default(cuid())

  /// URL d'envoi fournie par le navigateur, unique par appareil/navigateur.
  endpoint String @unique

  /// Clés de chiffrement du message (fournies par le navigateur à l'abonnement).
  p256dh String
  auth   String

  createdAt DateTime @default(now())
}

/// Modèle du rendez-vous hebdomadaire, utilisé par le job qui crée
/// automatiquement le sondage de la semaine (src/jobs/generate-recurring.ts).
model RecurrenceTemplate {
  id          String  @id @default(cuid())
  title       String
  description String?

  /// Jour du match : 0 = dimanche, 5 = vendredi, 6 = samedi.
  weekday Int

  /// Combien d'heures avant le match les réponses se ferment (ex. 18h,
  /// soit la veille à 18h pour un match le lendemain midi).
  deadlineHoursBefore Int @default(18)

  /// Combien de jours avant le match le sondage est créé (ex. 3, le mardi
  /// pour un match le vendredi).
  leadTimeDays Int @default(3)

  active Boolean @default(true)

  /// Token de gestion du modèle (mêmes règles que pour un sondage).
  organizerToken String @unique

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
