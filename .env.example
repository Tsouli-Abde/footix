# Variables du déploiement (docker-compose.prod.yml).
# Copier en .env à la racine et remplir avant de lancer la stack de production.

# Domaine sur lequel Caddy obtient son certificat. Il doit pointer sur la machine.
# Avec docker-compose.shared.yml (un autre Caddy tient déjà 80/443), cette valeur
# n'est plus utilisée mais doit quand même être renseignée : Compose lit les
# variables avant de savoir quels services vont tourner.
FOOTIX_DOMAIN=footix.exemple.duckdns.org

# Mot de passe PostgreSQL. À changer, il n'a pas de valeur par défaut en prod.
POSTGRES_PASSWORD=

# Notifications push. Générer la paire avec :
#   cd backend && npx web-push generate-vapid-keys
# Laisser vide désactive simplement les notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.fr
